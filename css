.cabecalho {
  display: grid;
  /*justify-content: space-between;*/
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  padding: 20px 40px;
  background-color: #59082E;
  color: #0f0f0f;
  position: relative;
}
.logo {
  font-size: 24px;
  font-weight: bold;
  justify-self: start; /*garante que a logo enconste a direita*/
}
.logo img{
  width: 25%;
}
.menu {
  display: flex;
  gap: 20px;
  /*width: max-content;*/
  /*flex-shrink: 0; /*Impede o menu de encolher e esmagar o texto*/
  justify-self: center; /*trava exatamente no centro da tela*/
  font-size: 20px;
}
.menu a {
  white-space: nowrap;
  color: #ececec;
  text-decoration: none;
}
.menu a:hover {
  color: 2c0707;
}
.menu-toggle {
  display: none;
  font-size: 28px;
  background: none;
  border: none;
  cursor: pointer;
}

.carrinho {
  display: flex;
  align-items: center ;
  justify-self: end; /*Força o carrinho a ir para o extremo direito*/
  gap: 20px;
}

.ajuste_icone_carrinho img {
  width: 100%;
  height: auto;
  display: block;
}

.ajuste_icone_carrinho {
  position: relative;
  display: flex;
  align-items: center;
  width: 90px;
}

.valor_carrinho {
  position: absolute;
  top: -5px;
  right: 25px;
  background-color: rgb(219, 180, 101);
  color: #ececec;
  font-size: 20px;
  font-weight: bold;
  border-radius: 50%; 
  width: 35px;
  height: 35px;
  display: flex;
  justify-content: center;
  align-items: center;
}
@media (max-width: 768px) {
  .cabecalho {
    padding: 15px 20px;
  }
  .menu-toggle {
    display: block;
  }
  .menu {
    display: none;
    flex-direction: column;
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background-color: #fffefe;
    padding: 20px;
    gap: 15px;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    z-index: 10;
  }
  .menu.ativo {
    display: flex;
  }
}

/*Inicio Index*/
.container{
  display: flex;
  flex-direction: row;

}
.side{
  flex: 25%;
  background-color: #8C2957;
  padding: 20px;

}
.main{
  flex: 75%;
  background-color: #f8f7f7;
  padding: 20px;
}

.main img{
  width: 101%;
}

/*Buscar*/

.busca {
    margin-bottom: 30px;
}

.busca input[type="search"]{
  flex: 1;
  width: 230px;
  padding: 12px 15px;
  border-radius:  8px;
  border: 1px solid #ccc;
}
.busca h2 {
    margin-bottom: 15px;
}
.busca form {
    display: flex;
    gap: 10px;
}
.busca button{
  background-color: #2c0707(241, 153, 53);
  border: none;
  color: #2c0707;
  border-radius: 8px;
  box-shadow: 2px 2px 2px black;
  padding: 12px 20px;
  cursor: pointer;
  transition: 0.3s;
}
.busca button:hover {
    background-color: #59082E;
}

/*menu-departamentos*/
.menu-departamentos {
  clear: left;
  margin: 10px;
  margin-bottom: 10px;
}

/*remove as bolinhas de listagem*/
.menu-departamentos ul {
    list-style: none;
    margin-left: -30;
}

.menu-departamentos h2 {
    background-color: #e9dfdf;
    color: #59082E;
    padding: 18px 20px;
    border-radius: 8px;
    margin-bottom: 15px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
}

.menu-departamentos h3 {
    background-color: #2c0707;
    color: white;
    padding: 15px 20px;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
}

.menu-departamentos li {
  background-color: #59082E;
  border-radius: 5px;
  margin-bottom: 1px;
  padding: 4px 10px; /*espaço entre as linhas*/
}
.menu-departamentos ul {
  margin-left: -30px;
  list-style-type: none;
}

.menu-departamentos a{
  color:rgba(236, 181, 62, 0.61);
  text-decoration: none;
}

.menu-departamentos li ul{
  display: none;
}

.menu-departamentos li:hover ul{
  display: block;
}

.promocoes {
  display: flex;
  flex-wrap: wrap;
  background-color: #fffefe(129, 129, 129);
}

.promocoes div{
  background-color: #59082E;
  width: 220px;
  height: 270px;
  padding: 17px;
  margin-left: 7.5px;
  margin: 7.5px;
  color: white;
  border-radius: 10px;
}

.promocoes div img{
  width: 100%;
  height: 270px;
}

/*Fim Index*/
